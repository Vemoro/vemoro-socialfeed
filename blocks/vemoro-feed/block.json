{
  "apiVersion": 3,
  "name": "vemoro-socialfeed/feed",
  "version": "2.0.0",
  "title": "Vemoro SocialFeed",
  "category": "widgets",
  "icon": "instagram",
  "description": "Zeigt lokal synchronisierte Instagram-Beiträge an.",
  "textdomain": "local-instagram-feed",
  "editorScript": "lif-block-editor",
  "editorStyle": "lif-block-editor",
  "attributes": {
    "heading": { "type": "string", "default": "" },
    "heading_level": { "type": "number", "default": 2 },
    "heading_font_family": { "type": "string", "default": "" },
    "heading_font_size": { "type": "string", "default": "" },
    "heading_custom_font_size": { "type": "number", "default": 40 },
    "heading_color": { "type": "string", "default": "" },
    "heading_align": { "type": "string", "default": "" },
    "heading_weight": { "type": "string", "default": "" },
    "heading_style": { "type": "string", "default": "" },
    "heading_spacing": { "type": "number", "default": 16 },
    "posts": { "type": "number" },
    "columns": { "type": "number" },
    "columns_tablet": { "type": "number" },
    "columns_mobile": { "type": "number" },
    "show_caption": { "type": "boolean" },
    "show_date": { "type": "boolean" },
    "show_username": { "type": "boolean" },
    "show_metrics": { "type": "boolean" },
    "show_link": { "type": "boolean" },
    "show_video_indicator": { "type": "boolean" },
    "caption_length": { "type": "number" },
    "aspect_ratio": { "type": "string" },
    "order": { "type": "string" },
    "class": { "type": "string" },
    "section_background": { "type": "string" },
    "full_viewport_background": { "type": "boolean", "default": false }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "spacing": { "padding": true, "margin": ["top", "bottom"] }
  }
}
