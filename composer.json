{
  "name": "vemoro/vemoro-socialfeed-for-wp",
  "description": "Development dependencies for Vemoro SocialFeed for WP; runtime has no Composer dependency.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.1" },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "yoast/phpunit-polyfills": "^2.0.5"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=phpcs.xml.dist"
  },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true } }
}
